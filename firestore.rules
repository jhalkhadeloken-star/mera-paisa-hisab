rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             data.openingBalancePaise is int &&
             data.openingBalancePaise >= 0 &&
             data.openingBalancePaise <= 100000000000 &&
             data.monthlyBudgetPaise is int &&
             data.monthlyBudgetPaise >= 0 &&
             data.monthlyBudgetPaise <= 100000000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTransaction(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.type is string &&
             data.type in ['EXPENSE', 'INCOME'] &&
             data.amountPaise is int &&
             data.amountPaise > 0 &&
             data.amountPaise <= 100000000000 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 60 &&
             data.note is string &&
             data.note.size() <= 250 &&
             data.dateKey is string &&
             data.dateKey.size() == 10 &&
             data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.monthKey is string &&
             data.monthKey.size() == 7 &&
             data.monthKey.matches('^\\d{4}-\\d{2}$') &&
             data.source is string &&
             data.source in ['MANUAL', 'SMART_TEXT', 'UDHAR_SYNC'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidUdharEntry(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.personName is string &&
             data.personName.size() >= 1 &&
             data.personName.size() <= 80 &&
             data.personKey is string &&
             data.personKey.size() >= 1 &&
             data.personKey.size() <= 80 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             data.entryType is string &&
             data.entryType in ['GIVEN', 'BORROWED', 'REPAYMENT_RECEIVED', 'REPAYMENT_PAID'] &&
             data.amountPaise is int &&
             data.amountPaise > 0 &&
             data.amountPaise <= 100000000000 &&
             data.dateKey is string &&
             data.dateKey.size() == 10 &&
             data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             (!('dueDateKey' in data) || (data.dueDateKey is string && data.dueDateKey.size() == 10 && data.dueDateKey.matches('^\\d{4}-\\d{2}-\\d{2}$'))) &&
             data.note is string &&
             data.note.size() <= 250 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'openingBalancePaise', 'monthlyBudgetPaise', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'openingBalancePaise', 'monthlyBudgetPaise', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'openingBalancePaise', 'monthlyBudgetPaise', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll(['userId', 'type', 'amountPaise', 'category', 'note', 'dateKey', 'monthKey', 'source', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'type', 'amountPaise', 'category', 'note', 'dateKey', 'monthKey', 'source', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amountPaise', 'category', 'note', 'dateKey', 'monthKey', 'source', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
      }

      match /udharEntries/{entryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         incoming().keys().hasAll(['userId', 'personName', 'personKey', 'entryType', 'amountPaise', 'dateKey', 'note', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'personName', 'personKey', 'phone', 'entryType', 'amountPaise', 'dateKey', 'dueDateKey', 'note', 'createdAt', 'updatedAt']) &&
                         isValidUdharEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         isValidUdharEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['personName', 'personKey', 'phone', 'entryType', 'amountPaise', 'dateKey', 'dueDateKey', 'note', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }
    }
  }
}
